---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { displayImageUrl, imageSrcSet } from '../lib/media';
import recentBuildsData from '../data/homepage/recent-builds.json';
import testimonialsData from '../data/homepage/testimonials.json';
import { ORGANIZATION_ID, SITE_IDENTITY, SITE_URL } from '../data/siteIdentity.js';
import { isPublicProduct } from '../lib/productVisibility';

const allProducts = (await getCollection('products')).filter(isPublicProduct);
type ProductEntry = typeof allProducts[number];
const isProduct = (product: ProductEntry | undefined): product is ProductEntry => Boolean(product);
const featuredOrder = [
  'advent-2150-hardtop-slide-on',
  'mercedes-sprinter-motorhome',
  'sunpatch-15xc-couples-offroad-van',
  'sunpatch-12c-couples-caravan',
];
const featuredProducts = featuredOrder
  .map(slug => allProducts.find(p => p.slug === slug))
  .filter(isProduct);
const activeProductSlugs = new Set<string>(allProducts.map(product => product.slug));
const visibleRecentBuilds = recentBuildsData
  .filter(build => build.isVisible)
  .filter((build) => {
    const linkedSlug = build.productSlug ?? build.link.replace(/^\/+|\/+$/g, '');
    return !linkedSlug || activeProductSlugs.has(linkedSlug);
  })
  .sort((a, b) => a.sortOrder - b.sortOrder);
const visibleTestimonials = testimonialsData
  .filter(testimonial => testimonial.isVisible)
  .sort((a, b) => a.sortOrder - b.sortOrder);
const rangeImages = {
  expedition: '/images/site/homepage-expedition-vehicles.webp',
  slideOn: '/images/site/homepage-slide-on-campers.webp',
  caravan: '/images/optimized/products/sunpatch-12c-couples-caravan/01-sunpatch-12c-couples-caravan-hero.webp',
  custom: '/images/site/homepage-custom-builds.webp',
  story: '/images/optimized/products/expedition/unimog-overlander-camper/02-mog2.webp',
  expeditionHighlight: '/images/site/expedition-hero.webp',
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  "name": SITE_IDENTITY.name,
  "url": SITE_IDENTITY.url,
  "publisher": { "@id": ORGANIZATION_ID },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://beyondrv.com.au/our-slide-on-campers/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};
const heroImage = '/images/site/unimog-hero-960.webp';
const heroSrcSet = [480, 720, 960, 1200, 1458]
  .map(width => `/images/site/unimog-hero-${width}.webp ${width}w`)
  .join(', ');
const heroSizes = '100vw';
---
<BaseLayout
  title="Beyond RV — Queensland Slide-On Campers, Caravans & Expedition Vehicles"
  description="Beyond RV completes slide-on campers, hardtop caravans, and expedition vehicles in Mutdapilly, Queensland. For HiLux, Ranger, Unimog, and serious trucks."
  structuredData={websiteSchema}
  preloadImage={{ src: heroImage, srcset: heroSrcSet, sizes: heroSizes }}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg">
      <img
        src={heroImage}
        srcset={heroSrcSet}
        sizes={heroSizes}
        alt=""
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-overlay-bottom"></div>

    <div class="hero-content">
      <div class="hero-eyebrow">
        <div class="hero-eyebrow-line"></div>
        <span class="hero-eyebrow-text">Queensland's Slide-On Specialists</span>
      </div>
      <h1 class="hero-title">
        Built For<br>
        <span class="italic">Where</span><br>
        <span class="accent">Roads End</span>
      </h1>
      <p class="hero-sub">
        Slide-on campers completed in Queensland for Unimogs, Ivecos, Isuzu trucks and serious utes.
        Practical systems, careful fit-out, and clear handover.
      </p>
      <div class="hero-actions">
        <a href="/our-slide-on-campers/" class="btn-primary">Explore the Range</a>
        <a href="/inquiry-form/" class="btn-ghost">Get a Build Quote</a>
      </div>
    </div>

    <div class="hero-stats">
      <div class="hero-stat">
          <div class="hero-stat-num">15</div>
          <div class="hero-stat-label">Years RV Experience</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-num">QLD</div>
        <div class="hero-stat-label">Gas &amp; 240V Certified</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-num">4<span>x</span></div>
        <div class="hero-stat-label">Vehicle Classes</div>
      </div>
    </div>

    <div class="hero-scroll" aria-hidden="true">
      <div class="hero-scroll-line"></div>
      <div class="hero-scroll-text">Scroll</div>
    </div>
  </section>

  <!-- TICKER -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      <span class="ticker-item">Caravans</span>
      <span class="ticker-item ticker-dot">✦</span>
      <span class="ticker-item">Slide-On Campers</span>
      <span class="ticker-item ticker-dot">✦</span>
      <span class="ticker-item">Unimog Builds</span>
      <span class="ticker-item ticker-dot">✦</span>
      <span class="ticker-item">Iveco Daily</span>
      <span class="ticker-item ticker-dot">✦</span>
      <span class="ticker-item">Isuzu NPR</span>
      <span class="ticker-item ticker-dot">✦</span>
      <span class="ticker-item">Custom Ute Campers</span>
      <span class="ticker-item ticker-dot">✦</span>
      <span class="ticker-item">QLD Gas &amp; 240V Certified</span>
      <span class="ticker-item ticker-dot">✦</span>
      <span class="ticker-item">Expedition Ready</span>
      <span class="ticker-item ticker-dot">✦</span>
      <!-- Duplicate for seamless loop -->
      <span class="ticker-item">Caravans</span>
      <span class="ticker-item ticker-dot">✦</span>
      <span class="ticker-item">Slide-On Campers</span>
      <span class="ticker-item ticker-dot">✦</span>
      <span class="ticker-item">Unimog Builds</span>
      <span class="ticker-item ticker-dot">✦</span>
      <span class="ticker-item">Iveco Daily</span>
      <span class="ticker-item ticker-dot">✦</span>
      <span class="ticker-item">Isuzu NPR</span>
      <span class="ticker-item ticker-dot">✦</span>
      <span class="ticker-item">Custom Ute Campers</span>
      <span class="ticker-item ticker-dot">✦</span>
      <span class="ticker-item">QLD Gas &amp; 240V Certified</span>
      <span class="ticker-item ticker-dot">✦</span>
      <span class="ticker-item">Expedition Ready</span>
      <span class="ticker-item ticker-dot">✦</span>
    </div>
  </div>

  <!-- RANGE OVERVIEW (3-card category grid) -->
  <section class="range">
    <div class="range-header">
      <div>
        <div class="section-eyebrow reveal">
          <div class="section-eyebrow-line"></div>
          <span class="section-eyebrow-text">Our Range</span>
        </div>
        <h2 class="section-title reveal reveal-delay-1">Three Ranges.<br>One Standard.</h2>
      </div>
      <a href="/our-slide-on-campers/" class="btn-ghost reveal reveal-delay-2">View All Models →</a>
    </div>

    <div class="range-grid">
      <div class="model-card featured reveal">
        <img
          src={displayImageUrl(rangeImages.expedition, 1200)}
          srcset={imageSrcSet(rangeImages.expedition, [640, 960, 1200, 1380])}
          sizes="(max-width: 900px) 100vw, 66vw"
          alt="Beyond RV Expedition Vehicles — Isuzu NPS builds"
          loading="lazy"
          decoding="async"
          style="object-position: center 40%"
        />
        <div class="model-card-overlay"></div>
        <div class="model-card-content">
          <span class="model-tag">Expedition</span>
          <div class="model-name">Expedition Vehicles</div>
          <div class="model-spec">Unimog · Isuzu NPS · Custom builds for where roads end</div>
          <a href="/expedition/" class="model-link">Explore Expedition →</a>
        </div>
      </div>

      <div class="model-card featured reveal">
        <img
          src={displayImageUrl(rangeImages.slideOn, 1200)}
          srcset={imageSrcSet(rangeImages.slideOn, [640, 960, 1200, 1380])}
          sizes="(max-width: 900px) 100vw, 66vw"
          alt="Beyond RV Slide-On Campers — Advent range"
          loading="lazy"
          decoding="async"
          style="object-position: center 55%"
        />
        <div class="model-card-overlay"></div>
        <div class="model-card-content">
          <span class="model-tag">Slide-Ons</span>
          <div class="model-name">Slide-On Campers</div>
          <div class="model-spec">Advent 2150 · 2300 · 2450 · 7ft electric pop-top</div>
          <a href="/our-slide-on-campers/" class="model-link">Explore Slide-Ons →</a>
        </div>
      </div>

      <div class="model-card reveal reveal-delay-1">
        <img
          src={displayImageUrl(rangeImages.caravan, 800)}
          srcset={imageSrcSet(rangeImages.caravan, [480, 800, 1200])}
          sizes="(max-width: 900px) 100vw, 33vw"
          alt="Beyond RV Sunpatch caravans"
          loading="lazy"
          decoding="async"
        />
        <div class="model-card-overlay"></div>
        <div class="model-card-content">
          <span class="model-tag">Caravans</span>
          <div class="model-name">Our Caravans</div>
          <div class="model-spec">Sunpatch 15-XC · Off-road couples & family vans</div>
          <a href="/our-caravans/" class="model-link">Explore Caravans →</a>
        </div>
      </div>

      <div class="model-card reveal reveal-delay-2">
        <img
          src={displayImageUrl(rangeImages.custom, 1200)}
          srcset={imageSrcSet(rangeImages.custom, [640, 960, 1200, 1380])}
          sizes="(max-width: 900px) 100vw, 33vw"
          alt="Beyond RV interior fit-out"
          loading="lazy"
          decoding="async"
        />
        <div class="model-card-overlay"></div>
        <div class="model-card-content">
          <span class="model-tag">Custom</span>
          <div class="model-name">Custom Builds</div>
          <div class="model-spec">Vehicle-led planning · Custom specifications · Fitment checked</div>
          <a href="/custom/" class="model-link">Start a Custom Build →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- GUIDES AND TOOLS -->
  <section class="container authority-section">
    <div class="section-eyebrow reveal">
      <div class="section-eyebrow-line"></div>
      <span class="section-eyebrow-text">Research Before You Choose</span>
    </div>
    <h2 class="section-title reveal reveal-delay-1">Guides &amp; Weight Tools</h2>
    <div class="authority-grid" style="margin-top: 3rem">
      <a class="authority-card" href="/guides/best-utes-for-slide-on-campers/">
        <span class="authority-card-kicker">Vehicle fit</span>
        <h3>Best Utes for Slide-On Campers</h3>
        <p>Understand payload, tray size, accessories, axle limits and why the exact vehicle variant matters.</p>
      </a>
      <a class="authority-card" href="/guides/gvm-gcm-atm-gtm-explained/">
        <span class="authority-card-kicker">Weight terms</span>
        <h3>GVM, GCM, ATM &amp; GTM</h3>
        <p>Learn the main Australian vehicle and trailer weight terms through plain-English examples.</p>
      </a>
      <a class="authority-card" href="/vehicle-suitability-checker/">
        <span class="authority-card-kicker">Calculators</span>
        <h3>Check Your Vehicle</h3>
        <p>Use your own vehicle and camper figures to screen payload, fit and towing limits before enquiry.</p>
      </a>
    </div>
    <div style="margin-top: 2rem">
      <a href="/guides/" class="btn-primary">View All Guides</a>
    </div>
  </section>

  <!-- FEATURED PRODUCTS -->
  {featuredProducts.length > 0 && (
    <section style="background: var(--dark); border-top: 1px solid var(--border); padding: 7rem var(--gutter)">
      <div class="section-eyebrow reveal">
        <div class="section-eyebrow-line"></div>
        <span class="section-eyebrow-text">Featured</span>
      </div>
      <h2 class="section-title reveal reveal-delay-1">Ready to Roll</h2>
      <div class="product-grid" style="margin-top: 3rem">
        {featuredProducts.map(p => (
          <ProductCard
            title={p.data.title}
            slug={p.slug}
            category={p.data.category}
            tagline={p.data.tagline}
            price={p.data.price}
            status={p.data.status}
            heroImage={p.data.heroImage}
            priceBadge={p.data.priceBadge}
            compareAtPrice={p.data.compareAtPrice}
            saleLabel={p.data.saleLabel}
            availability={p.data.availability}
            sourceType={p.data.sourceType}
          />
        ))}
      </div>
    </section>
  )}

  <!-- STORY / WHY BEYONDRV -->
  <section class="story">
    <div class="story-image">
      <img
        src={displayImageUrl(rangeImages.story, 1200)}
        srcset={imageSrcSet(rangeImages.story)}
        sizes="(max-width: 900px) 100vw, 50vw"
        alt="Beyond RV Unimog expedition build — Mutdapilly Queensland workshop"
        loading="lazy"
        decoding="async"
      />
      <div class="story-image-overlay"></div>
    </div>
    <div class="story-content">
      <div class="section-eyebrow reveal">
        <div class="section-eyebrow-line"></div>
        <span class="section-eyebrow-text">How We Complete It</span>
      </div>
      <h2 class="section-title reveal reveal-delay-1">Completed<br>in Queensland</h2>
      <p style="font-size:0.95rem; color:var(--muted); line-height:1.8; margin-top:1.5rem" class="reveal reveal-delay-2">
        Our caravan and camper shells are imported, then completed at our workshop in Mutdapilly, Queensland.
        The agreed fitout, finishing, checks, handover and ongoing support are managed by the Beyond RV team.
      </p>
      <p style="font-size:0.95rem; color:var(--muted); line-height:1.8; margin-top:1rem" class="reveal reveal-delay-3">
        The result: expedition-grade quality completed to the applicable Australian Design Rule requirements,
        with careful sourcing and local completion — not corners cut.
      </p>
      <div class="story-numbers reveal reveal-delay-3">
        <div class="story-num">
          <div class="story-num-val">QLD</div>
          <div class="story-num-label">Workshop Completion</div>
        </div>
        <div class="story-num">
          <div class="story-num-val">ADR</div>
          <div class="story-num-label">Applicable Requirements</div>
        </div>
        <div class="story-num">
          <div class="story-num-val">15</div>
          <div class="story-num-label">Years RV Experience</div>
        </div>
        <div class="story-num">
          <div class="story-num-val">QLD</div>
          <div class="story-num-label">Family Business</div>
        </div>
      </div>
    </div>
  </section>

  <!-- EXPEDITION HIGHLIGHT -->
  <section style="background: var(--dark); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 7rem var(--gutter)">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; max-width: var(--max-width); margin: 0 auto">
      <div>
        <div class="section-eyebrow reveal">
          <div class="section-eyebrow-line"></div>
          <span class="section-eyebrow-text">Expedition Range</span>
        </div>
        <h2 class="section-title reveal reveal-delay-1">For the ones<br>who <span style="color: var(--orange)">go furthest.</span></h2>
        <p style="font-size: 0.95rem; color: var(--muted); line-height: 1.8; margin-top: 1.5rem; max-width: 420px" class="reveal reveal-delay-2">
          Explore Unimog and Isuzu NPS options for overlanders who genuinely leave all roads behind.
          Composite expedition bodies configured around the vehicle and intended travel.
        </p>
        <div style="margin-top: 2.5rem" class="reveal reveal-delay-3">
          <a href="/expedition/" class="btn-primary">Explore Expedition Range</a>
        </div>
      </div>
      <div style="aspect-ratio: 16/10; overflow: hidden; position: relative" class="reveal reveal-delay-1">
        <img
          src={displayImageUrl(rangeImages.expeditionHighlight, 1200)}
          srcset={imageSrcSet(rangeImages.expeditionHighlight)}
          sizes="(max-width: 900px) 100vw, 50vw"
          alt="Beyond RV Isuzu NPS expedition camper"
          loading="lazy"
          decoding="async"
          style="width: 100%; height: 100%; object-fit: cover; filter: brightness(0.8)"
        />
      </div>
    </div>
  </section>

  <!-- HOW YOUR BUILD WORKS -->
  <section class="build-process">
    <div class="container">
      <div class="section-eyebrow reveal">
        <div class="section-eyebrow-line"></div>
        <span class="section-eyebrow-text">The Process</span>
      </div>
      <h2 class="section-title reveal reveal-delay-1">How Your<br><span style="color: var(--orange)">Build Works</span></h2>
      <p class="section-sub reveal reveal-delay-2">
        Five steps from first contact to handing over the keys — all managed out of our Mutdapilly workshop.
      </p>
      <div class="build-steps">
        <div class="build-step reveal">
          <div class="build-step-num">01</div>
          <div class="build-step-body">
            <div class="build-step-title">Tell Us Your Vehicle</div>
            <div class="build-step-desc">Share your truck make, model and tray configuration. We work across HiLux, Ranger, Isuzu, Iveco, Unimog and custom platforms.</div>
          </div>
        </div>
        <div class="build-step reveal reveal-delay-1">
          <div class="build-step-num">02</div>
          <div class="build-step-body">
            <div class="build-step-title">Choose Your Build</div>
            <div class="build-step-desc">Slide-on camper, caravan or full expedition fitout. We walk you through the options that suit your vehicle and your travel style.</div>
          </div>
        </div>
        <div class="build-step reveal reveal-delay-2">
          <div class="build-step-num">03</div>
          <div class="build-step-body">
            <div class="build-step-title">Confirm Dimensions, Payload &amp; Requirements</div>
            <div class="build-step-desc">We lock in the specs — tray dimensions, GVM payload, electrical requirements and any custom fitout. No surprises later.</div>
          </div>
        </div>
        <div class="build-step reveal reveal-delay-3">
          <div class="build-step-num">04</div>
          <div class="build-step-body">
            <div class="build-step-title">Queensland Fitout &amp; Compliance</div>
            <div class="build-step-desc">Our Mutdapilly team completes the agreed fitout and finishing for each project. Every completed unit is checked against the relevant Australian compliance requirements before it leaves the floor.</div>
          </div>
        </div>
        <div class="build-step reveal reveal-delay-4">
          <div class="build-step-num">05</div>
          <div class="build-step-body">
            <div class="build-step-title">Handover &amp; Ongoing Support</div>
            <div class="build-step-desc">We walk you through your build at handover and stay available for questions, servicing and warranty claims — Queensland-based, not a call centre.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <section class="trust">
    <div class="section-eyebrow reveal">
      <div class="section-eyebrow-line"></div>
      <span class="section-eyebrow-text">Why Beyond RV</span>
    </div>
    <h2 class="section-title reveal reveal-delay-1">Completed Differently</h2>
    <div class="trust-grid">
      <div class="trust-card reveal reveal-delay-1">
        <div class="trust-icon">⚡</div>
        <div class="trust-title">Full Electrical Fitout</div>
        <div class="trust-desc">Every wire run by our QLD team. Solar, lithium battery, 240V, 12V — all to Australian standards.</div>
      </div>
      <div class="trust-card reveal reveal-delay-2">
        <div class="trust-icon">🔧</div>
        <div class="trust-title">Truck Compatibility</div>
        <div class="trust-desc">We specify and fit to your vehicle's tray and payload. Utes to Unimogs — we've worked across them all.</div>
      </div>
      <div class="trust-card reveal reveal-delay-3">
        <div class="trust-icon">🛡</div>
        <div class="trust-title">Australian Warranty</div>
        <div class="trust-desc">Five-year construction warranty, with individual appliances retaining their respective manufacturer warranties.</div>
      </div>
      <div class="trust-card reveal reveal-delay-4">
        <div class="trust-icon">⛺</div>
        <div class="trust-title">Custom Builds</div>
        <div class="trust-desc">No catalogue limits. Tell us exactly what you need. We scope it, fit it and complete it at Mutdapilly.</div>
      </div>
    </div>
  </section>

  <!-- RECENT BUILDS & FITOUTS -->
  <section class="workshop-gallery">
    <div class="container">
      <div class="section-eyebrow reveal">
        <div class="section-eyebrow-line"></div>
        <span class="section-eyebrow-text">Recent Builds &amp; Fitouts</span>
      </div>
      <h2 class="section-title reveal reveal-delay-1">Recent Builds<br><span style="color: var(--orange)">&amp; Fitouts</span></h2>
      <p class="section-sub reveal reveal-delay-2">
        Every project that leaves Mutdapilly goes through the same process — specified, fitted and checked against the applicable requirements by our Queensland team.
      </p>
      <div class="workshop-grid reveal reveal-delay-2">
        {visibleRecentBuilds.map(build => (
          <div class="workshop-card">
            <div class="workshop-card-image">
              <img
                src={displayImageUrl(build.image, 800)}
                srcset={imageSrcSet(build.image, [480, 800, 1200])}
                sizes="(max-width: 900px) 100vw, 33vw"
                alt={build.alt}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="workshop-card-body">
              <div class="workshop-card-title">
                {build.link ? <a href={build.link}>{build.title}</a> : build.title}
              </div>
              <div class="workshop-card-tags">
                {build.tags.map(tag => (
                  <span class="workshop-tag">{tag}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CUSTOMER TESTIMONIALS -->
  <section class="testimonials-section">
    <div class="container">
      <div class="section-eyebrow reveal">
        <div class="section-eyebrow-line"></div>
        <span class="section-eyebrow-text">What Customers Say</span>
      </div>
      <h2 class="section-title reveal reveal-delay-1">Built to Last.<br><span style="color: var(--orange)">Backed by Real Owners.</span></h2>
      <div class="testimonials-grid">
        {visibleTestimonials.map((testimonial, index) => (
          <div class={`testimonial-card reveal${index > 0 ? ` reveal-delay-${Math.min(index, 2)}` : ''}`}>
            <p class="testimonial-quote">{testimonial.quote}</p>
            <div class="testimonial-author">
              <strong>— {testimonial.customerName}</strong>
              {(testimonial.productName || testimonial.customerLocation) && (
                <span>{[testimonial.productName, testimonial.customerLocation].filter(Boolean).join(' · ')}</span>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="faq-grid">
      <div class="faq-sticky">
        <div class="section-eyebrow reveal">
          <div class="section-eyebrow-line"></div>
          <span class="section-eyebrow-text">FAQ</span>
        </div>
        <h2 class="section-title reveal reveal-delay-1">Common<br>Questions</h2>
