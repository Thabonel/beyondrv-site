---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { displayImageUrl, imageSrcSet } from '../../lib/media';

const schema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Beyond RV",
  "url": "https://beyondrv.com.au/about-us/",
  "description": "Beyond RV is an Australian RV business based in Mutdapilly, Queensland, with 15 years of experience across caravans, campers and motorhomes."
};
const heroImage = '/images/site/about-hero.webp';
const storyImage = '/images/site/farmer-dave.webp';
---
<BaseLayout
  title="About Beyond RV | 15 Years of RV Experience"
  description="Meet Beyond RV, an Australian RV business based in Mutdapilly, Queensland, with 15 years of experience across caravans, campers and motorhomes."
  activePath="/about-us/"
  structuredData={schema}
>
  <section class="page-hero">
    <div class="page-hero-bg" style={`background-image: url('${displayImageUrl(heroImage, 1600)}')`}></div>
    <div class="hero-overlay"></div>
    <div class="hero-overlay-bottom"></div>
    <div class="page-hero-content">
      <div class="section-eyebrow">
        <div class="section-eyebrow-line"></div>
        <span class="section-eyebrow-text">About Beyond RV</span>
      </div>
      <h1 class="hero-title">15 Years of<br><span class="accent">RV Experience.</span></h1>
      <p class="hero-sub">
        Practical caravan, camper and motorhome experience, with customer support from our Mutdapilly workshop.
      </p>
    </div>
  </section>

  <!-- Story -->
  <section class="story">
    <div class="story-image">
      <img
        src={displayImageUrl(storyImage, 1200)}
        srcset={imageSrcSet(storyImage)}
        sizes="(max-width: 900px) 100vw, 50vw"
        alt="Beyond RV workshop — Mutdapilly, Queensland"
        loading="lazy"
        decoding="async"
      />
      <div class="story-image-overlay"></div>
    </div>
    <div class="story-content">
      <div class="section-eyebrow reveal">
        <div class="section-eyebrow-line"></div>
        <span class="section-eyebrow-text">Our Story</span>
      </div>
      <h2 class="section-title reveal reveal-delay-1">Completed<br>in Queensland</h2>
      <p style="font-size:0.95rem; color:var(--muted); line-height:1.8; margin-top:1.5rem" class="reveal reveal-delay-2">
        Beyond RV is a family-run workshop with 15 years of hands-on RV experience.
        We complete slide-on campers, truck campers, off-road caravans, and expedition bodies at
        our base in Mutdapilly, Queensland.
      </p>
      <p style="font-size:0.95rem; color:var(--muted); line-height:1.8; margin-top:1rem" class="reveal reveal-delay-3">
        Customers deal directly with people who understand the build process: payload, chassis suitability,
        power systems, water storage, cabinetry, compliance, and how a camper actually behaves once it leaves
        the bitumen.
      </p>
      <p style="font-size:0.95rem; color:var(--muted); line-height:1.8; margin-top:1rem" class="reveal reveal-delay-3">
        Every product is finished with the same practical focus: strong composite construction where it matters,
        reliable electrical and plumbing systems, clear handover, and a layout matched to the way the owner travels.
      </p>
      <div class="story-numbers reveal reveal-delay-3">
        <div class="story-num">
          <div class="story-num-val">QLD</div>
          <div class="story-num-label">Gas &amp; 240V Certified</div>
        </div>
        <div class="story-num">
          <div class="story-num-val">ADR</div>
          <div class="story-num-label">Requirements</div>
        </div>
        <div class="story-num">
          <div class="story-num-val">15</div>
          <div class="story-num-label">Years RV Experience</div>
        </div>
        <div class="story-num">
          <div class="story-num-val">QLD</div>
          <div class="story-num-label">Family Business</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact / Location -->
  <section class="container">
    <div class="page-content">
      <h2>Find Us</h2>
      <p>We're based in Mutdapilly, Queensland — about an hour south-west of Brisbane.</p>
      <p>
        <strong>Address:</strong> 77 Coleyville Rd, Mutdapilly QLD 4307<br />
        <strong>Phone:</strong> <a href="tel:+61430863819">0430 863 819</a><br />
        <strong>Email:</strong> <a href="mailto:beyondcaravans@gmail.com">beyondcaravans@gmail.com</a>
      </p>
      <p>
        Viewings are by appointment — call or use the enquiry form below to arrange a time.
      </p>
      <p>
        Explore our <a href="/our-slide-on-campers/">slide-on campers</a>,
        <a href="/our-caravans/">off-road caravans</a>, and
        <a href="/expedition/">expedition vehicles</a>, or talk to us about a
        <a href="/custom/">custom build</a>.
      </p>
      <div style="margin-top: 2rem">
        <a href="/inquiry-form/" class="btn-primary">Book a Viewing</a>
      </div>
    </div>
  </section>
</BaseLayout>
