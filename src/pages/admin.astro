---
import AdminApp from '../components/AdminApp';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Workspace" />
    <link rel="manifest" href="/sales-workspace.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>Beyond RV Admin</title>
    <meta name="description" content="Private Beyond RV sales and administration workspace." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://beyondrv.com.au/admin/" />
    <meta property="og:title" content="Beyond RV Admin" />
    <meta property="og:description" content="Private Beyond RV administration area." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { height: 100%; background: #0a0a0a; color: #fff; font-family: 'Outfit', system-ui, sans-serif; }
      header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 0 1rem; height: 60px;
        background: #111; border-bottom: 1px solid #333;
      }
      header img { height: 36px; }
      header span { color: #888; font-size: 0.85rem; }
      .admin-shell-nav { display: flex; align-items: center; gap: 0.4rem; }
      .admin-shell-nav a {
        color: #aaa; text-decoration: none; font-size: 0.85rem; font-weight: 700;
        padding: 0.4rem 0.65rem; border-radius: 6px; border: 1px solid transparent;
      }
      .admin-shell-nav a:hover { color: #fff; border-color: #444; }
      .admin-shell-nav a.active { color: #fff; background: #1a1a1a; border-color: #333; }
      .sr-only {
        position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
        overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
      }
      @media (max-width: 900px) {
        header {
          align-items: flex-start;
          gap: 0.75rem;
          padding: 0.75rem 0.8rem;
          height: auto;
          flex-wrap: wrap;
        }
        header img { height: 32px; }
        header nav { display: flex; gap: 0.4rem; flex-wrap: wrap; }
        header nav a { margin-left: 0; }
        .admin-topbar-note { display: none; }
      }
      @media (max-width: 900px) {
        .admin-tab-bar {
          display: none !important;
        }
        .admin-mobile-nav { display: block !important; }
        .admin-new-product-form {
          padding: 0.75rem !important;
          gap: 0.65rem !important;
        }
        .admin-new-product-form .admin-form-grid,
        .admin-new-product-form .admin-form-grid--two,
        .admin-new-product-form .admin-form-grid--three,
        .admin-new-product-form .admin-form-grid--four,
        .admin-new-product-form .admin-form-grid--image {
          grid-template-columns: 1fr !important;
        }
        .admin-new-product-form .admin-shop-details {
          padding: 0.5rem !important;
        }
        .admin-new-product-form .admin-form-header {
          flex-direction: column;
          align-items: stretch;
        }
        .admin-new-product-form input,
        .admin-new-product-form select,
        .admin-new-product-form textarea {
          min-height: 6rem;
          width: 100%;
          min-width: 0;
          font-size: 16px !important;
        }
        .admin-edit-product-form,
        .admin-order-modal {
          width: calc(100vw - 1rem) !important;
          max-width: calc(100vw - 1rem) !important;
        }
        .admin-edit-product-form {
          padding: 0.75rem !important;
          gap: 0.65rem !important;
        }
        .admin-edit-product-form .admin-form-grid,
        .admin-edit-product-form .admin-form-grid--two,
        .admin-edit-product-form .admin-form-grid--three,
        .admin-edit-product-form .admin-form-grid--four,
        .admin-edit-product-form .admin-form-grid--image,
        .admin-order-modal .admin-form-grid,
        .admin-order-modal .admin-form-grid--two,
        .admin-order-modal .admin-form-grid--three,
        .admin-order-modal .admin-form-grid--four {
          grid-template-columns: 1fr !important;
        }
        .admin-order-modal > div {
          max-height: 92vh !important;
        }
        .admin-edit-product-form .admin-form-header,
        .admin-order-modal .admin-form-header {
          flex-direction: column;
          align-items: stretch;
        }
        .admin-edit-product-form input,
        .admin-edit-product-form select,
        .admin-edit-product-form textarea,
        .admin-order-modal input,
        .admin-order-modal select,
        .admin-order-modal textarea {
          width: 100%;
          min-width: 0;
          font-size: 16px !important;
        }
        .admin-edit-product-form textarea,
        .admin-order-modal textarea {
          min-height: 6rem;
        }
      }
    </style>
  </head>
  <body>
    <h1 class="sr-only">Beyond RV Admin</h1>
    <header>
      <div style="display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap">
        <img src="/images/site/admin-logo.png" alt="Beyond RV" width="48" height="36" loading="eager" decoding="async" />
        <nav class="admin-shell-nav" data-persistent-admin-navigation aria-label="Admin navigation">
          <a href="/admin/" class="active" aria-current="page">Admin</a>
          <a href="/admin/analytics/">Analytics</a>
        </nav>
      </div>
      <span class="admin-topbar-note">Secure Beyond RV workspace</span>
    </header>
    <AdminApp client:load />
  </body>
</html>
