---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { displayImageUrl } from '../../lib/media';
import { getVehicleCatalogue } from '../../lib/vehicleCatalogue.ts';
import { serializeJsonForHtml } from '../../lib/safeJson.ts';
import { getCollection } from 'astro:content';
import { isPublicProduct } from '../../lib/productVisibility';
import { ESTIMATE_DISCLAIMER } from '../../lib/vehicleSuitabilityCalculator.js';
const vehicleCatalogue = getVehicleCatalogue();
const vehicleCatalogueJson = serializeJsonForHtml(vehicleCatalogue);

const pageUrl = 'https://beyondrv.com.au/slide-on-camper-weight-calculator/';
const heroImage = '/images/site/homepage-slide-on-campers.webp';
const disclaimer = ESTIMATE_DISCLAIMER;

const faqs = [
  {
    q: 'What is available payload?',
    a: 'Available payload is the amount of weight left before your vehicle reaches GVM after you allow for its current weight, passengers, accessories, fuel, water, tools and gear.'
  },
  {
    q: 'Does tray size matter as much as payload?',
    a: 'Yes. A slide-on camper must suit the physical tray or tub as well as the manufacturer ratings and loaded weight limits. Tray length, tray width, centre of gravity and rear overhang all matter.'
  },
  {
    q: 'Should I use tare weight or weighbridge weight?',
    a: 'Use a current weighbridge weight whenever possible. Tare figures often do not include accessories, tray changes, bull bars, winches, canopies or real touring gear.'
  }
];

// Campers are built to order, so the model name is the tray length it is built
// for. The sizes live on the product entry, not in a second list here.
// A product belongs in the finder when someone has recorded the tray length it
// is built for. Complete vehicles never get one, so they never appear, and
// adding a camper later is a data change rather than a code change.
const camperEntries = (await getCollection('products'))
  .filter(isPublicProduct)
  .filter((entry) => Boolean(entry.data.suitabilityData?.requiredTrayLengthMm));

function nominalLengthMm(entry: typeof camperEntries[number]): number | null {
  const raw = entry.data.suitabilityData?.requiredTrayLengthMm;
  if (raw === undefined || raw === '') return null;
  const value = Number(raw);
  // The schema types this as a string, so an unparseable value would otherwise
  // read as NaN, and a model with no size would suit every tray.
  if (!Number.isInteger(value) || value <= 0) {
    throw new Error(`${entry.id}: suitabilityData.requiredTrayLengthMm must be a positive whole number of millimetres, got ${JSON.stringify(raw)}`);
  }
  return value;
}

const camperModels = camperEntries
  .map((entry) => ({
    slug: entry.id,
    name: entry.data.title,
    url: `/${entry.id}/`,
    nominalLengthMm: nominalLengthMm(entry),
    status: entry.data.suitabilityData?.status ?? 'draft',
  }))
  .sort((a, b) => (b.nominalLengthMm ?? -1) - (a.nominalLengthMm ?? -1));

const camperModelsJson = serializeJsonForHtml(camperModels);

const products = camperModels.map((model) => ({
  name: model.name,
  url: model.url,
  dryWeight: 'Manual entry required',
}));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Slide-On Camper Weight Calculator',
    url: pageUrl,
    description: 'Manual Australian payload and GVM calculator for checking whether a ute may suit a Beyond RV slide-on camper.'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(item => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a }
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://beyondrv.com.au/' },
      { '@type': 'ListItem', position: 2, name: 'Vehicle Suitability Checker', item: 'https://beyondrv.com.au/vehicle-suitability-checker/' },
      { '@type': 'ListItem', position: 3, name: 'Slide-On Camper Weight Calculator', item: pageUrl }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Beyond RV slide-on campers referenced by this calculator',
    numberOfItems: products.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: products.map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: product.name,
      url: product.url
    }))
  }
];
---
<BaseLayout
  title="Slide-On Camper Weight Calculator | Beyond RV"
  description="Estimate whether your ute has enough payload, GVM margin and tray size for a Beyond RV slide-on camper. Manual Australian calculator for non-technical buyers."
  image={heroImage}
  activePath="/vehicle-suitability-checker/"
  structuredData={schema}
>
  <section class="page-hero page-hero--short page-hero--calculator">
    <div class="page-hero-bg" style={`background-image: url('${displayImageUrl(heroImage, 1600)}')`}></div>
    <div class="hero-overlay"></div>
    <div class="hero-overlay-bottom"></div>
    <div class="page-hero-content">
      <div class="section-eyebrow">
        <div class="section-eyebrow-line"></div>
        <span class="section-eyebrow-text">Slide-On Camper Weight Calculator</span>
      </div>
      <h1 class="hero-title">Can Your Ute Carry a Slide-On?</h1>
      <p class="hero-sub">
        Enter your own vehicle figures to estimate payload, loaded vehicle weight, GVM margin and which Beyond RV slide-on range may be worth discussing.
      </p>
    </div>
  </section>

  <section class="container camper-finder">
    <h2 class="camper-finder-title">Which model suits your tray?</h2>
    <p class="camper-finder-intro">
      Campers are built to order, so the question is which model your tray length calls for.
      Enter it and we will name the model.
    </p>
    <script type="application/json" id="camperModelData" set:html={camperModelsJson}></script>
    <div class="form-field">
      <label class="form-label" for="finderTrayLength">Tray length (mm)</label>
      <input class="form-input" id="finderTrayLength" type="number" min="0" placeholder="e.g. 2300" />
    </div>
    <div id="camperFinderResult" data-testid="camper-finder-result" hidden></div>
  </section>

  <section class="container checker-layout">
    <div class="checker-panel">
      <form class="checker-form" id="slideCalculator">
        <div class="form-section-heading form-field--full">
          <h2>Start with your ute</h2>
          <p>Enter GVM and current weight for the first payload result. The vehicle finder is optional.</p>
        </div>
        <div class="form-field form-field--full" id="vehiclePickerField">
          <label class="form-label" for="vehicleMake">Find your vehicle (optional)</label>
          <p class="form-help" id="vehiclePickerUnavailable" data-testid="vehicle-picker-unavailable" hidden>
            Vehicle lookup is unavailable while these specifications are being reviewed.
            Take your GVM from your compliance plate, and enter your ute's current weight
            below. An approximate weight is enough for an estimate.
          </p>
          <div class="vehicle-picker">
            <select class="form-input" id="vehicleMake"><option value="">Select a make</option></select>
            <select class="form-input" id="vehicleModel" disabled><option value="">Select a model</option></select>
            <select class="form-input" id="vehicleVariant" disabled><option value="">Select a variant</option></select>
          </div>
          <span class="form-help" id="vehiclePickerHelp">
            Picking a vehicle fills only the published figures available for that exact variant.
            Check every filled value; a weighbridge figure for your own vehicle is always better.
          </span>
          <div id="vehicleProvenance" class="vehicle-provenance" hidden></div>
        </div>
        <script type="application/json" id="vehicleCatalogueData" set:html={vehicleCatalogueJson}></script>
        <div class="form-field form-field--full">
          <label class="form-label" for="vehicleName">Vehicle</label>
          <input class="form-input" id="vehicleName" type="text" placeholder="Example: Ford Ranger dual cab" />
        </div>
        <div class="form-field">
          <label class="form-label" for="gvm">Vehicle GVM (kg)</label>
          <input class="form-input" id="gvm" type="number" min="0" placeholder="e.g. 3350" />
          <span class="form-help">Find this on the vehicle compliance plate or manufacturer specification.</span>
        </div>
        <div class="form-field">
          <label class="form-label" for="currentWeight">Current vehicle weight before listed additions (kg)</label>
          <input class="form-input" id="currentWeight" type="number" min="0" placeholder="e.g. 2200" />
          <span class="form-help">Use a current weighbridge weight if possible. If it already includes passengers or accessories, enter 0 for those items below.</span>
        </div>
        <div class="form-field" id="trayMassField" hidden>
          <label class="form-label" for="trayIncluded">The weight I entered above already includes my tray</label>
          <input id="trayIncluded" type="checkbox" />
          <span class="form-help">Tick this if you used a weighbridge figure taken with the tray fitted.</span>
          <div id="trayMassRow">
            <label class="form-label" for="trayMass">Tray weight (kg)</label>
            <input class="form-input" id="trayMass" type="number" min="0" placeholder="e.g. 120" />
            <span class="form-help" id="trayMassHelp"></span>
          </div>
        </div>
        <div class="form-section-heading form-field--full">
          <h2>Your planned load</h2>
          <p>Optional. Leave a field blank if it adds no extra weight; blank additions count as 0 kg.</p>
        </div>
        <div class="form-field">
          <label class="form-label" for="passengers">Passengers (kg)</label>
          <input class="form-input" id="passengers" type="number" min="0" placeholder="e.g. 180" />
        </div>
        <div class="form-field">
          <label class="form-label" for="accessories">Accessories already fitted (kg)</label>
          <input class="form-input" id="accessories" type="number" min="0" placeholder="e.g. 80" />
          <span class="form-help">Only include bull bar, winch, canopy, drawers, racks or battery weight not already counted above.</span>
        </div>
        <div class="form-field">
          <label class="form-label" for="luggageGear">Vehicle luggage and gear (kg)</label>
          <input class="form-input" id="luggageGear" type="number" min="0" placeholder="e.g. 120" />
        </div>
        <div class="form-section-heading form-field--full">
          <h2>Your camper</h2>
          <p>Dry weight starts the camper estimate. Leave water, gear or options blank if none are planned.</p>
        </div>
        <div class="form-field">
          <label class="form-label" for="camperDry">Camper dry weight (kg)</label>
          <input class="form-input" id="camperDry" type="number" min="0" placeholder="e.g. 650" />
          <span class="form-help">Use the confirmed product specification or ask Beyond RV.</span>
        </div>
        <div class="form-field">
          <label class="form-label" for="camperWater">Camper water weight (kg)</label>
          <input class="form-input" id="camperWater" type="number" min="0" placeholder="e.g. 80" />
        </div>
        <div class="form-field">
          <label class="form-label" for="camperGear">Camper gear weight (kg)</label>
          <input class="form-input" id="camperGear" type="number" min="0" placeholder="e.g. 100" />
        </div>
        <div class="form-field">
          <label class="form-label" for="camperOptions">Camper options weight (kg)</label>
          <input class="form-input" id="camperOptions" type="number" min="0" placeholder="e.g. 50" />
        </div>
        <div class="form-section-heading form-field--full">
          <h2>Tray fit</h2>
          <p>Measure the usable flat tray or tub area. Compare it with the camper’s confirmed required dimensions.</p>
        </div>
        <div class="form-field">
          <label class="form-label" for="trayLength">Tray or tub usable length (mm)</label>
          <input class="form-input" id="trayLength" type="number" min="0" placeholder="e.g. 2150" />
        </div>
        <div class="form-field">
          <label class="form-label" for="trayWidth">Tray or tub usable width (mm)</label>
          <input class="form-input" id="trayWidth" type="number" min="0" placeholder="e.g. 1850" />
        </div>
        <div class="form-field">
          <label class="form-label" for="requiredTrayLength">Required tray length (mm)</label>
          <input class="form-input" id="requiredTrayLength" type="number" min="0" placeholder="e.g. 2100" />
        </div>
        <div class="form-field">
          <label class="form-label" for="requiredTrayWidth">Required tray width (mm)</label>
          <input class="form-input" id="requiredTrayWidth" type="number" min="0" placeholder="e.g. 1750" />
        </div>
        <div class="form-section-heading form-field--full">
          <h2>Final safety checks</h2>
          <p>These checks improve confidence but do not block the preliminary figures above.</p>
        </div>
        <div class="form-field">
          <label class="form-label" for="rearAxleChecked">Rear axle limits checked</label>
          <input id="rearAxleChecked" type="checkbox" />
        </div>
        <div class="form-field">
          <label class="form-label" for="tyreRatingsChecked">Tyre ratings checked</label>
          <input id="tyreRatingsChecked" type="checkbox" />
        </div>
        <div class="form-field">
          <label class="form-label" for="centreOfGravityChecked">Centre of gravity checked</label>
          <input id="centreOfGravityChecked" type="checkbox" />
        </div>
      </form>
      <p class="calculator-disclaimer">{disclaimer}</p>
    </div>

    <aside class="result-panel" id="resultPanel" data-status="neutral" aria-live="polite">
      <div class="result-status" id="statusLabel">Enter GVM and current weight to start</div>
      <h2 id="resultTitle">Start with two numbers</h2>
      <p class="result-summary" id="resultSummary">Each result appears as soon as its own required information is available.</p>
      <div class="result-metrics">
        <div class="result-metric"><span>Available payload before camper</span><strong id="availablePayload">Not calculated</strong></div>
        <div class="result-metric"><span>Estimated loaded vehicle weight</span><strong id="loadedWeight">Not calculated</strong></div>
        <div class="result-metric"><span>Remaining GVM margin</span><strong id="gvmMargin">Not calculated</strong></div>
        <div class="result-metric"><span>Estimated loaded camper weight</span><strong id="loadedCamper">Not calculated</strong></div>
        <div class="result-metric"><span>Tray length fit</span><strong id="trayLengthFit">Not calculated</strong></div>
        <div class="result-metric"><span>Tray width fit</span><strong id="trayWidthFit">Not calculated</strong></div>
        <div class="result-metric"><span>Tray-size model match</span><strong id="camperModelMatch">Enter tray length</strong></div>
        <div class="result-metric"><span>Data quality</span><strong id="dataQuality">Needs review</strong></div>
      </div>
      <div class="result-recommendation">
        <strong>Next step</strong>
        <p id="recommendation">Add your first figures, then confirm the final result with Beyond RV.</p>
      </div>
      <ul class="result-notes" id="warningNotes"></ul>
      <a class="btn-primary" id="sendResult" href="/inquiry-form/?intent=vehicle-suitability">Continue to Enquiry With These Results</a>
    </aside>
  </section>

  <section class="authority-section authority-section--dark">
    <div class="container authority-copy">
      <h2>How this slide-on camper calculator works</h2>
      <p>
        The calculator starts with your vehicle GVM, subtracts the current vehicle weight, then allows for passengers, accessories, the camper dry weight and the loaded camper weight. It also flags tray dimensions because a ute can have enough payload but still be physically unsuitable.
      </p>
      <p>
        This is a GVM and fit estimate only. Final suitability also depends on axle ratings, tyre ratings, tray or tub rating, mounting method, load distribution, suspension setup and certified weighbridge results.
      </p>
      <div class="worked-example">
        <h3>Worked example</h3>
        <p>A ute with 3350kg GVM and a 2400kg current weighbridge weight has 950kg before it reaches GVM. If passengers, accessories and loaded camper weight add 1130kg, the vehicle is estimated at 3530kg loaded. That is 180kg over GVM, so the result is red.</p>
      </div>
      <h2>Beyond RV slide-on product data table</h2>
      <div class="authority-table-wrap">
        <table class="authority-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Data status</th>
              <th>Data needed</th>
            </tr>
          </thead>
          <tbody>
            {products.map(product => (
              <tr>
                <td><a href={product.url}>{product.name}</a></td>
                <td>Confirm with Beyond RV</td>
                <td>{product.dryWeight}, tray size, GVM margin, axle limits and weighbridge result.</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="container authority-section">
    <div class="authority-copy">
      <h2>Slide-on camper FAQ</h2>
      <div class="faq-list">
        {faqs.map(item => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { calculateSlideOnSuitability } from '../../lib/vehicleSuitabilityCalculator.js';
  import { isTrayMassRequired, resolveCurrentVehicleWeight } from '../../lib/slideOnVehicleWeight';
  import { emptyVehicleCatalogue, validateVehicleCatalogue } from '../../lib/vehicleCatalogue/validate';
  import { BUILD_TOLERANCE_MM, modelsForTray, type CamperModel } from '../../lib/camperModels';
  import {
    catalogueMakes,
    catalogueModelsForMake,
    catalogueVariantById,
    catalogueVariantsForModel,
  } from '../../lib/vehicleCatalogue/picker';
  import type { CatalogueVariant, VehicleCatalogue } from '../../lib/vehicleCatalogue/types';

  const form = document.getElementById('slideCalculator');
  const resultPanel = document.getElementById('resultPanel');
  const fields = ['vehicleName', 'gvm', 'currentWeight', 'trayMass', 'passengers', 'accessories', 'luggageGear', 'camperDry', 'camperWater', 'camperGear', 'camperOptions', 'trayLength', 'trayWidth', 'requiredTrayLength', 'requiredTrayWidth', 'rearAxleChecked', 'tyreRatingsChecked', 'centreOfGravityChecked'];
  let hasStarted = false;
  const byId = (id: string) => document.getElementById(id);
  const inputById = (id: string) => document.getElementById(id) as HTMLInputElement | null;
  const value = (id: string) => inputById(id)?.value ?? '';
  const fmt = (value: number) => `${Math.round(value).toLocaleString()} kg`;
  const fmtMm = (value: number) => `${Math.round(value).toLocaleString()} mm`;


  // --- which model suits this tray -----------------------------------------
  const modelDataEl = byId('camperModelData');
  let camperModels: CamperModel[] = [];
  try {
    camperModels = JSON.parse(modelDataEl?.textContent || '[]') as CamperModel[];
  } catch {
    console.warn('Camper model data could not be parsed; the model finder will be unavailable.');
  }

  const finderInput = inputById('finderTrayLength');
  const finderResult = byId('camperFinderResult');

  function modelLink(model: CamperModel) {
    const link = document.createElement('a');
    link.href = model.url;
    link.textContent = model.name;
    return link;
  }

  function bestModelForTray(trayLength: number) {
    return modelsForTray(trayLength, camperModels).find((result) => result.verdict === 'best');
  }

  function renderModelMatch() {
    const output = byId('camperModelMatch');
    const trayLength = Number(value('trayLength'));
    if (!output) return 'Not calculated';
    output.replaceChildren();
    if (!Number.isFinite(trayLength) || trayLength <= 0) {
      output.textContent = 'Enter tray length';
      return 'Not calculated';
    }
    const best = bestModelForTray(trayLength);
    if (!best) {
      output.textContent = 'No standard model';
      return 'No standard model';
    }
    output.append(modelLink(best.model));
    return best.model.name;
  }

  function renderFinder() {
    if (!finderResult || !finderInput) return;
    const trayLength = Number(finderInput.value);
    if (!Number.isFinite(trayLength) || trayLength <= 0) {
      finderResult.hidden = true;
      finderResult.replaceChildren();
      return;
    }

    const results = modelsForTray(trayLength, camperModels);
    const best = bestModelForTray(trayLength);
    const also = results.filter((r) => r.verdict === 'also_suits');
    const smaller = results.filter((r) => r.verdict === 'smaller');
    const tooLong = results.filter((r) => r.verdict === 'too_long');
    const unknown = results.filter((r) => r.verdict === 'unknown');

    finderResult.replaceChildren();
    finderResult.hidden = false;

    const headline = document.createElement('p');
    headline.className = 'camper-finder-headline';
    if (best) {
      const strong = document.createElement('strong');
      strong.appendChild(modelLink(best.model));
      headline.append(strong, document.createTextNode(` — built for a ${best.model.nominalLengthMm} mm tray.`));
      const choose = document.createElement('button');
      choose.type = 'button';
      choose.className = 'btn-ghost camper-finder-choose';
      choose.dataset.testid = 'camper-finder-choose';
      choose.textContent = 'Use available dimensions below';
      choose.addEventListener('click', () => {
        const required = inputById('requiredTrayLength');
        const tray = inputById('trayLength');
        if (required && best.model.nominalLengthMm) {
          required.value = String(best.model.nominalLengthMm);
          required.dispatchEvent(new Event('input', { bubbles: true }));
        }
        if (tray && !tray.value) {
          tray.value = String(trayLength);
          tray.dispatchEvent(new Event('input', { bubbles: true }));
        }
        byId('slideCalculator')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      finderResult.append(headline, choose);
    } else {
      headline.textContent = 'No standard model is built for a tray this short. Beyond RV builds to order, so talk to us about your vehicle.';
      finderResult.append(headline);
    }

    // Two models within the build tolerance of each other are the same size
    // decision, so say what actually differs.
    // The early return above narrows finderResult, but that narrowing does not
    // reach inside a nested function, so hold it in a local.
    const panel = finderResult;
    function listLine(testId: string, lead: string, entries: typeof also, tail = '.') {
      const line = document.createElement('p');
      line.className = 'camper-finder-note';
      line.dataset.testid = testId;
      line.append(document.createTextNode(lead));
      entries.forEach((r, index) => {
        if (index > 0) line.append(document.createTextNode(', '));
        line.append(modelLink(r.model));
      });
      line.append(document.createTextNode(tail));
      panel.append(line);
    }

    if (best) {
      // A model the same size as the best one is a different camper, not a
      // different fit. A model a size down genuinely is smaller. Saying both in
      // one sentence made the "same size" claim cover something that was not.
      const sameSize = also.filter((r) =>
        Math.abs((r.model.nominalLengthMm ?? 0) - (best.model.nominalLengthMm ?? 0)) <= BUILD_TOLERANCE_MM);
      const oneSizeDown = also.filter((r) => !sameSize.includes(r));

      if (sameSize.length) {
        listLine('camper-finder-same-size', 'The same size for your tray: ', sameSize,
          '. The difference is in the camper, not the fit.');
      }
      if (oneSizeDown.length) {
        listLine('camper-finder-also', 'One size down, if you want more room around it: ', oneSizeDown);
      }
    }

    // Smaller campers do fit, they are just not what a tray this size calls for.
    // Named quietly rather than offered as alternatives.
    if (smaller.length) {
      const line = document.createElement('p');
      line.className = 'camper-finder-note';
      line.dataset.testid = 'camper-finder-smaller';
      line.append(document.createTextNode('Smaller campers fit too, if you want spare tray space: '));
      smaller.forEach((r, index) => {
        if (index > 0) line.append(document.createTextNode(', '));
        line.append(modelLink(r.model));
      });
      line.append(document.createTextNode('.'));
      finderResult.append(line);
    }

    if (tooLong.length) {
      const line = document.createElement('p');
      line.className = 'camper-finder-note';
      line.dataset.testid = 'camper-finder-too-long';
      line.append(document.createTextNode('Too long for this tray: '));
      tooLong.forEach((r, index) => {
        if (index > 0) line.append(document.createTextNode(', '));
        line.append(modelLink(r.model));
      });
      line.append(document.createTextNode('.'));
      finderResult.append(line);
    }

    if (unknown.length) {
      const line = document.createElement('p');
      line.className = 'camper-finder-note';
      line.dataset.testid = 'camper-finder-unknown';
      line.append(document.createTextNode('Made to order, talk to Beyond RV about: '));
      unknown.forEach((r, index) => {
        if (index > 0) line.append(document.createTextNode(', '));
        line.append(modelLink(r.model));
      });
      line.append(document.createTextNode('.'));
      finderResult.append(line);
    }

    const indicative = camperModels.some((model) => model.status !== 'confirmed');
    if (indicative) {
      const note = document.createElement('p');
      note.className = 'camper-finder-note';
      note.dataset.testid = 'camper-finder-indicative';
      note.textContent = 'Indicative. Campers are built to order, so Beyond RV confirms the final size with you before build.';
      finderResult.append(note);
    }
  }

  finderInput?.addEventListener('input', renderFinder);

  const catalogueEl = document.getElementById('vehicleCatalogueData');
  function parseCatalogue(): VehicleCatalogue {
    if (!catalogueEl) return emptyVehicleCatalogue();
    try {
      const validation = validateVehicleCatalogue(JSON.parse(catalogueEl.textContent || 'null'));
      if (validation.valid) return validation.catalogue;
      console.warn('Vehicle catalogue data is invalid; the vehicle picker will be unavailable.', validation.errors);
    } catch (err) {
      console.warn('Vehicle catalogue data could not be parsed; the vehicle picker will be unavailable.', err);
    }
    return emptyVehicleCatalogue();
  }
  const catalogue = parseCatalogue();
  const customerEdited = new Set<string>();
  // The catalogue says whether the published kerb mass includes a tray; only
  // the customer knows whether the weight they actually typed does. See
  // isTrayMassRequired and resolveCurrentVehicleWeight.
  let trayState = 'not_applicable';
  let trayRequired = false;
  // The provenance panel has to be redrawn whenever what it claims stops being
  // true, which means keeping hold of the variant it is describing.
  let selectedVariant: CatalogueVariant | null = null;

  function syncTrayRequirement() {
    const includedBox = inputById('trayIncluded');
    const currentWeightIncludesTray = includedBox?.checked ?? false;
    trayRequired = isTrayMassRequired({ trayState, currentWeightIncludesTray });

    // Asking for a weight that is already counted would double it, so the
    // field goes away rather than sitting there inviting the mistake.
    const trayInput = inputById('trayMass');
    const trayRow = byId('trayMassRow');
    if (trayRow) (trayRow as HTMLElement).hidden = currentWeightIncludesTray;
    if (currentWeightIncludesTray) clearTrayMass();
    if (trayInput) trayInput.required = trayRequired;
  }

  const PREFILLABLE_FIELDS = ['vehicleName', 'gvm', 'currentWeight', 'trayLength', 'trayWidth', 'trayMass'];
  const FIELD_LABELS: Record<string, string> = {
    vehicleName: 'the vehicle name',
    gvm: 'GVM',
    currentWeight: 'the current vehicle weight',
    trayLength: 'the tray length',
    trayWidth: 'the tray width',
    trayMass: 'the tray weight',
  };
  const fieldLabel = (id: string) => FIELD_LABELS[id] ?? id;

  const selectById = (id: string) => document.getElementById(id) as HTMLSelectElement | null;

  function fillSelect(select: HTMLSelectElement | null, values: string[], placeholder: string) {
    if (!select) return;
    select.replaceChildren();
    const first = document.createElement('option');
    first.value = '';
    first.textContent = placeholder;
    select.appendChild(first);
    for (const value of values) {
      const option = document.createElement('option');
      option.value = value;
      option.textContent = value;
      select.appendChild(option);
    }
    select.disabled = values.length === 0;
  }

  function setIfNotEdited(id: string, value: number | null) {
    if (customerEdited.has(id)) return;
    const input = inputById(id);
    if (input) input.value = value === null ? '' : String(value);
  }

  PREFILLABLE_FIELDS.forEach((id) => {
    inputById(id)?.addEventListener('input', () => {
      const alreadyEdited = customerEdited.has(id);
      customerEdited.add(id);
      // Redraw only on the first edit of a field; the note is the same after.
      if (!alreadyEdited && selectedVariant) renderProvenance(selectedVariant);
    });
  });

  function formatAccessedDate(iso: string) {
    const [year, month, day] = (iso ?? '').split('-').map(Number);
    const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    const valid = Number.isFinite(year) && Number.isFinite(day) && month >= 1 && month <= 12;
    return valid ? `${day} ${months[month - 1]} ${year}` : String(iso);
  }

  function trayLine(trayState: string) {
    if (trayState === 'included') return 'Kerb mass includes the standard tray.';
    if (trayState === 'excluded') return 'Kerb mass excludes the tray.';
    if (trayState === 'not_applicable') return 'This is a tub vehicle, so no tray applies.';
    return 'The manufacturer does not state whether kerb mass includes a tray.';
  }

  const CORRECTED_FIELD_LABELS: Record<string, string> = {
    gvmKg: 'the GVM',
    kerbKg: 'the kerb mass',
    payloadKg: 'the payload',
    trayLengthMm: 'the tray length',
    trayWidthMm: 'the tray width',
  };
  function correctedFieldLabel(field: string) {
    return CORRECTED_FIELD_LABELS[field] ?? field;
  }

  function renderProvenance(variant: CatalogueVariant) {
    const panel = byId('vehicleProvenance');
    if (!panel) return;
    panel.replaceChildren();

    const line = document.createElement('p');
    const link = document.createElement('a');
    link.href = variant.source.url;
    link.textContent = variant.source.title;
    link.rel = 'noopener';
    link.target = '_blank';
    line.append(
      document.createTextNode(`Published by ${variant.source.manufacturer} in `),
      link,
      document.createTextNode(`, checked ${formatAccessedDate(variant.source.accessedDate)}. ${trayLine(variant.trayState)}`),
    );
    panel.appendChild(line);

    if (variant.promotedByOverride) {
      const note = document.createElement('p');
      note.className = 'vehicle-provenance-note';
      note.textContent = 'This variant was published to the selector manually by Beyond RV.';
      panel.appendChild(note);
    }

    // The kerb mass is the manufacturer's lightest-equipment figure, so the
    // payload shown is the best case. Saying so is the difference between an
    // estimate and an overstatement.
    if (variant.kerbIsOptimistic) {
      const note = document.createElement('p');
      note.className = 'vehicle-provenance-note';
      note.dataset.testid = 'vehicle-optimistic-kerb';
      note.textContent = 'This kerb mass is the manufacturer\u2019s lightest-equipment figure, so the payload shown here is a best case. A vehicle with options fitted weighs more and carries less. Beyond RV weighs your vehicle at the factory before build.';
      panel.appendChild(note);
    }

    // The largest body this chassis accepts, which is not the tray anyone
    // fitted. Saying so stops a truck owner reading it as their tray length.
    if (variant.platform === 'truck' && variant.maxBodyLengthMm) {
      const note = document.createElement('p');
      note.className = 'vehicle-provenance-note';
      note.dataset.testid = 'vehicle-max-body-length';
      note.textContent = `This chassis takes a body up to ${variant.maxBodyLengthMm} mm. That is the maximum it is rated for, not the tray fitted to your vehicle, so measure yours.`;
      panel.appendChild(note);
    }

    // A corrected figure did not come from the manufacturer document linked
    // above, so saying who it did come from is the whole point of recording it.
    if (variant.correctedFields.length > 0) {
      const note = document.createElement('p');
      note.className = 'vehicle-provenance-note';
      note.dataset.testid = 'vehicle-provenance-corrected';
      note.textContent = `Beyond RV corrected ${variant.correctedFields.map(correctedFieldLabel).join(', ')}. Those figures are not from the manufacturer document.`;
      panel.appendChild(note);
    }

    const editedFields = PREFILLABLE_FIELDS.filter((id) => customerEdited.has(id));
    if (editedFields.length > 0) {
      const editedNote = document.createElement('p');
      editedNote.className = 'vehicle-provenance-note';
      editedNote.textContent = `You supplied ${editedFields.map(fieldLabel).join(', ')}. Those figures are not from the manufacturer document.`;
      panel.appendChild(editedNote);
    }

    (panel as HTMLElement).hidden = false;
  }

  // A hidden tray field must never contribute to the calculation, even if the
  // customer had typed a value into it for a previously selected vehicle —
  // so this clears the value and drops it from customerEdited, not just
  // hides the field.
  function clearTrayMass() {
    const trayInput = inputById('trayMass');
    if (trayInput) trayInput.value = '';
    const wasEdited = customerEdited.delete('trayMass');
    // Clearing fires no input event, so nothing else would redraw the panel and
    // it would go on claiming a figure the customer supplied and no longer has.
    if (wasEdited && selectedVariant) renderProvenance(selectedVariant);
  }

  function resetVehicleSelection() {
    PREFILLABLE_FIELDS.forEach((id) => {
      if (customerEdited.has(id)) return;
      const input = inputById(id);
      if (input) input.value = '';
    });
    const trayField = byId('trayMassField');
    if (trayField) (trayField as HTMLElement).hidden = true;
    trayState = 'not_applicable';
    const includedBox = inputById('trayIncluded');
    if (includedBox) includedBox.checked = false;
    clearTrayMass();
    syncTrayRequirement();
    selectedVariant = null;
    const panel = byId('vehicleProvenance');
    if (panel) {
      panel.replaceChildren();
      (panel as HTMLElement).hidden = true;
    }
    calculateSlideOn();
  }

  function applyVariant(variantId: string) {
    const variant = catalogueVariantById(catalogue, variantId);
    if (!variant) return;
    setIfNotEdited('gvm', variant.gvmKg);
    setIfNotEdited('currentWeight', variant.kerbKg);
    setIfNotEdited('trayLength', variant.trayLengthMm);
    setIfNotEdited('trayWidth', variant.trayWidthMm);

    const nameInput = inputById('vehicleName');
    if (nameInput && !customerEdited.has('vehicleName')) nameInput.value = variant.label;

    const trayField = byId('trayMassField');
    const trayHelp = byId('trayMassHelp');
    const showTray = variant.trayState === 'excluded' || variant.trayState === 'unknown';
    trayState = variant.trayState;
    // The inclusion claim is about one vehicle's tray, and this call can
    // replace the very weight it referred to. Carrying it over lets a published
    // kerb mass that excludes a tray pass as though it included one.
    const includedBox = inputById('trayIncluded');
    if (includedBox) includedBox.checked = false;
    if (trayField) (trayField as HTMLElement).hidden = !showTray;
    if (!showTray) clearTrayMass();
    syncTrayRequirement();
    if (trayHelp) {
      trayHelp.textContent = variant.trayState === 'excluded'
        ? 'The published kerb weight for this vehicle excludes the tray. Enter your tray weight here and it will be added to the vehicle weight — do not count it again under accessories.'
        : 'The manufacturer does not state whether the published kerb weight includes a tray. If your vehicle has one, enter its weight here and it will be added to the vehicle weight — do not count it again under accessories.';
    }
    selectedVariant = variant;
    renderProvenance(variant);
    calculateSlideOn();
  }

  inputById('trayIncluded')?.addEventListener('change', () => {
    syncTrayRequirement();
    calculateSlideOn();
  });

  selectById('vehicleMake')?.addEventListener('change', (event) => {
    const make = (event.target as HTMLSelectElement).value;
    const models = catalogueModelsForMake(catalogue, make);
    fillSelect(selectById('vehicleModel'), models, 'Select a model');
    fillSelect(selectById('vehicleVariant'), [], 'Select a variant');
    resetVehicleSelection();
  });

  selectById('vehicleModel')?.addEventListener('change', (event) => {
    const make = selectById('vehicleMake')?.value;
    const model = (event.target as HTMLSelectElement).value;
    const variants = catalogueVariantsForModel(catalogue, make ?? '', model);
    const select = selectById('vehicleVariant');
    if (!select) return;
    select.replaceChildren();
    const first = document.createElement('option');
    first.value = '';
    first.textContent = 'Select a variant';
    select.appendChild(first);
    for (const variant of variants) {
      const option = document.createElement('option');
      option.value = variant.id;
      option.textContent = variant.label;
      select.appendChild(option);
    }
    select.disabled = variants.length === 0;
    resetVehicleSelection();
  });

  selectById('vehicleVariant')?.addEventListener('change', (event) => {
    const variantId = (event.target as HTMLSelectElement).value;
    if (!variantId) {
      resetVehicleSelection();
      return;
    }
    applyVariant(variantId);
  });

  // With nothing published, three dead dropdowns read as a broken page. Say
  // what is happening and leave the manual path exactly as it was.
  const pickerAvailable = catalogue.variants.length > 0;
  const pickerRow = document.querySelector('.vehicle-picker');
  const pickerNotice = byId('vehiclePickerUnavailable');
  if (pickerRow) (pickerRow as HTMLElement).hidden = !pickerAvailable;
  if (pickerNotice) (pickerNotice as HTMLElement).hidden = pickerAvailable;
  // This explains how to use a control that is not on screen.
  const pickerHelp = byId('vehiclePickerHelp');
  if (pickerHelp) (pickerHelp as HTMLElement).hidden = !pickerAvailable;

  fillSelect(selectById('vehicleMake'), catalogueMakes(catalogue), 'Select a make');
  type SlideOnResultValues = {
    availablePayloadBeforeCamper?: number;
    estimatedLoadedVehicleWeight?: number;
    remainingGvmMargin?: number;
    estimatedLoadedCamperWeight?: number;
    trayLengthFit?: number;
    trayWidthFit?: number;
  };
  const kgOrNotCalculated = (value?: number) => value === undefined ? 'Not calculated' : fmt(value);
  const mmOrNotCalculated = (value?: number) => value === undefined ? 'Not calculated' : fmtMm(value);

  function setText(id: string, value: string) {
    const el = byId(id);
    if (el) el.textContent = value;
  }

  function setNotes(notes: string[]) {
    const warningNotes = byId('warningNotes');
    if (!warningNotes) return;
    warningNotes.replaceChildren();
    notes.forEach((note: string) => {
      const item = document.createElement('li');
      item.textContent = note;
      warningNotes.appendChild(item);
    });
  }

  function currentVehicleWeightWithTray() {
    return resolveCurrentVehicleWeight({
      currentWeightRaw: value('currentWeight'),
      trayMassRaw: value('trayMass'),
      trayRequired,
    });
  }

  function calculateSlideOn() {
    const vehicleName = inputById('vehicleName')?.value || 'your vehicle';
    const result = calculateSlideOnSuitability({
      vehicleGvm: value('gvm'),
      currentVehicleWeight: currentVehicleWeightWithTray(),
      passengerWeight: value('passengers'),
      accessoryWeight: value('accessories'),
      luggageOrGearWeight: value('luggageGear'),
      camperDryWeight: value('camperDry'),
      camperWaterWeight: value('camperWater'),
      camperGearWeight: value('camperGear'),
      camperOptionsWeight: value('camperOptions'),
      trayLength: value('trayLength'),
      trayWidth: value('trayWidth'),
      requiredTrayLength: value('requiredTrayLength'),
      requiredTrayWidth: value('requiredTrayWidth'),
      rearAxleChecked: inputById('rearAxleChecked')?.checked ?? false,
      tyreRatingsChecked: inputById('tyreRatingsChecked')?.checked ?? false,
      centreOfGravityChecked: inputById('centreOfGravityChecked')?.checked ?? false
    }, { started: hasStarted });
    const values: SlideOnResultValues = 'values' in result ? result.values : {};

    resultPanel?.setAttribute('data-status', result.status);
    setText('statusLabel', result.statusLabel);
    setText('resultTitle', result.title);
    setText('resultSummary', result.summary);
    setText('availablePayload', kgOrNotCalculated(values.availablePayloadBeforeCamper));
    setText('loadedWeight', kgOrNotCalculated(values.estimatedLoadedVehicleWeight));
    setText('gvmMargin', kgOrNotCalculated(values.remainingGvmMargin));
    setText('loadedCamper', kgOrNotCalculated(values.estimatedLoadedCamperWeight));
    setText('trayLengthFit', mmOrNotCalculated(values.trayLengthFit));
    setText('trayWidthFit', mmOrNotCalculated(values.trayWidthFit));
    const camperModelMatch = renderModelMatch();
    setText('dataQuality', result.dataQuality);
    setText('recommendation', result.recommendation);
    setNotes(result.notes);

    const message = [
      'Vehicle Suitability Checker result - slide-on camper',
      `Vehicle: ${vehicleName}`,
      `Status: ${result.statusLabel}`,
      `Available payload before camper: ${kgOrNotCalculated(values.availablePayloadBeforeCamper)}`,
      `Estimated loaded vehicle weight: ${kgOrNotCalculated(values.estimatedLoadedVehicleWeight)}`,
      `Remaining GVM margin: ${kgOrNotCalculated(values.remainingGvmMargin)}`,
      `Estimated loaded camper weight: ${kgOrNotCalculated(values.estimatedLoadedCamperWeight)}`,
      `Tray length fit: ${mmOrNotCalculated(values.trayLengthFit)}`,
      `Tray width fit: ${mmOrNotCalculated(values.trayWidthFit)}`,
      `Tray-size model match: ${camperModelMatch}`,
      `Data quality: ${result.dataQuality}`,
      `Recommendation: ${result.recommendation}`
    ].join('\n');
    const send = byId('sendResult');
    if (send) send.setAttribute('href', `/inquiry-form/?intent=vehicle-suitability&message=${encodeURIComponent(message)}&fit_check_summary=${encodeURIComponent(message)}`);
  }

  fields.forEach(id => byId(id)?.addEventListener('input', () => {
    hasStarted = true;
    calculateSlideOn();
  }));
  form?.addEventListener('submit', (event) => event.preventDefault());
</script>
